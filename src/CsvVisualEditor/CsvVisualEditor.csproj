<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <IsPackable>false</IsPackable>
    <AssemblyName>CsvVisualEditor</AssemblyName>
    <RootNamespace>CsvVisualEditor</RootNamespace>
    <Version>0.12.0-alpha</Version>

    <!--
      The Windows Forms runtime currently emits framework-owned IL3000/IL3053
      Native AOT analysis warnings. The official Npp.DotNet WinForms template
      permits these warnings, so this host project must not promote linker/ILC
      warnings to errors. Nullable warnings in our own C# code remain errors.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npp.DotNet.Plugin" Version="1.0.0-alpha.10" />
    <ProjectReference Include="../CsvVisualEditor.Core/CsvVisualEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Windows.Forms" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TrimMode>link</TrimMode>
    <MetricsSupport>false</MetricsSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <IlcTrimMetadata>true</IlcTrimMetadata>
    <StackTraceSupport>false</StackTraceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <IlcGenerateCompleteTypeMetadata>false</IlcGenerateCompleteTypeMetadata>
    <Http3Support>false</Http3Support>
    <UseSizeOptimizedLinq>true</UseSizeOptimizedLinq>
  </PropertyGroup>
</Project>
