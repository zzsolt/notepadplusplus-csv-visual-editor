<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <IsPackable>false</IsPackable>
    <AssemblyName>CsvVisualEditor.NativeAot.SmokeTests</AssemblyName>
    <RootNamespace>CsvVisualEditor.NativeAot.SmokeTests</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TrimMode>link</TrimMode>
    <StackTraceSupport>true</StackTraceSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseSizeOptimizedLinq>true</UseSizeOptimizedLinq>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CsvVisualEditor.Core/CsvVisualEditor.Core.csproj" />
    <Compile Include="../../src/CsvVisualEditor/NativeAotRoots.cs" Link="NativeAotRoots.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvDataGridView.cs" Link="CsvDataGridView.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvEditingControlPasteHook.cs" Link="CsvEditingControlPasteHook.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvGridManagedRowSelection.cs" Link="CsvGridManagedRowSelection.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvGridRowPresentation.cs" Link="CsvGridRowPresentation.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvGridRowHeaderBehavior.cs" Link="CsvGridRowHeaderBehavior.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvGridSelectionSnapshot.cs" Link="CsvGridSelectionSnapshot.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvTransformDialog.cs" Link="CsvTransformDialog.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvWhitespaceCellPainter.cs" Link="CsvWhitespaceCellPainter.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvCommandIcons.cs" Link="CsvCommandIcons.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvCommandSurface.cs" Link="CsvCommandSurface.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvSearchBar.cs" Link="CsvSearchBar.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvAboutDialog.cs" Link="CsvAboutDialog.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvDataToolCommands.cs" Link="CsvDataToolCommands.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvDataToolStyle.cs" Link="CsvDataToolStyle.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvDataViewDialog.cs" Link="CsvDataViewDialog.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvColumnSummaryDialog.cs" Link="CsvColumnSummaryDialog.cs" />
    <Compile Include="../../src/CsvVisualEditor/CsvHostApplyCoordinator.cs" Link="CsvHostApplyCoordinator.cs" />
  </ItemGroup>
</Project>
